params {
    checkv_db   = '/fastscratch/tylerdoe/databases/checkv-db-v1.5'
    pharokka_db = '/fastscratch/tylerdoe/databases/pharokka_db'
    prophage_db = '/fastscratch/tylerdoe/databases/prophage_db.dmnd'
}

// Centralized container cache shared across runs
apptainer.cacheDir = '/fastscratch/tylerdoe/PHINDER/apptainer_cache'
