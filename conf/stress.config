/*
========================================================================================
    Stress-test overrides — load with: -c conf/stress.config
    Goal: find where PHINDER breaks, so a failing task must be RECORDED, not end the run.
========================================================================================
*/

process {
    // withName:'.*' (loaded after nextflow.config) overrides the per-process retry→terminate
    // strategies too. Resource closures using task.attempt still scale on the retries.
    withName: '.*' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
}

// Per-task status table that bin/score_stress_test.py reads (name includes the sample tag).
// The file path is set on the command line (-with-trace <outdir>/pipeline_trace.txt): params.outdir
// is not reliably resolved inside a -c config file.
trace.overwrite = true
trace.fields    = 'task_id,hash,name,status,exit,attempt,duration,realtime,peak_rss,workdir'
report.overwrite = true   // -resume reruns would otherwise abort on the existing report file
